{
  "openapi": "3.1.0",
  "info": {
    "title": "Barti Freight",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/loads": {
      "post": {
        "tags": [
          "loads"
        ],
        "operationId": "create_load",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLoadInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Load created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoadResource"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "LOAD_CONFLICT",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddressInput": {
        "type": "object",
        "required": [
          "line1",
          "city",
          "region",
          "postalCode",
          "country"
        ],
        "properties": {
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": [
              "string",
              "null"
            ]
          },
          "postalCode": {
            "type": "string"
          },
          "region": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AddressResource": {
        "type": "object",
        "required": [
          "line1",
          "city",
          "region",
          "postalCode",
          "country"
        ],
        "properties": {
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": [
              "string",
              "null"
            ]
          },
          "postalCode": {
            "type": "string"
          },
          "region": {
            "type": "string"
          }
        }
      },
      "CreateLoadInput": {
        "type": "object",
        "required": [
          "shipperId",
          "stops"
        ],
        "properties": {
          "shipperId": {
            "type": "string"
          },
          "stops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StopInput"
            }
          }
        },
        "additionalProperties": false
      },
      "LoadResource": {
        "type": "object",
        "required": [
          "id",
          "shipperId",
          "stops",
          "createdAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "shipperId": {
            "type": "string"
          },
          "stops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StopResource"
            }
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "status",
          "detail",
          "instance"
        ],
        "properties": {
          "correlationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "type": {
            "type": "string"
          },
          "violations": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ViolationDto"
            }
          }
        }
      },
      "StopInput": {
        "type": "object",
        "required": [
          "kind",
          "date",
          "address"
        ],
        "properties": {
          "address": {
            "$ref": "#/components/schemas/AddressInput"
          },
          "date": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/StopKindPl"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "StopKindPl": {
        "type": "string",
        "enum": [
          "pickup",
          "delivery"
        ]
      },
      "StopResource": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "date",
          "address"
        ],
        "properties": {
          "address": {
            "$ref": "#/components/schemas/AddressResource"
          },
          "date": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/StopKindPl"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ViolationDto": {
        "type": "object",
        "required": [
          "path",
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    }
  }
}
