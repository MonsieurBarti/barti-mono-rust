LOADS_MIGRATOR_DATABASE_URL=postgres://loads_migrator:loads_migrator@127.0.0.1:5432/hive
LOADS_DATABASE_URL=postgres://loads:loads@127.0.0.1:5432/hive
LOADS_POOL_MAX=10

# Db lane (scripts/test-db.sh, scripts/coverage.sh). Never hive. Tests map hive_test onto hive_test_<slot>.
LOADS_TEST_MIGRATOR_DATABASE_URL=postgres://loads_migrator:loads_migrator@127.0.0.1:5432/hive_test
LOADS_TEST_DATABASE_URL=postgres://loads:loads@127.0.0.1:5432/hive_test
GRANT_PROOF_DATABASE_URL=postgres://grant_proof:grant_proof@127.0.0.1:5432/hive_test

# pgbot inspect (read-only pg_monitor). Product database, not hive_test.
PGBOT_DATABASE_URL=postgres://pgbot_ro:pgbot_ro@127.0.0.1:5432/hive?sslmode=disable

# Optional. Serve defaults to info and runs with no collector.
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

